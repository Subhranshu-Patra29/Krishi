<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Krishi" parent="Theme.Material3.Light.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.Krishi" parent="Base.Theme.Krishi" />

    <style name="CustomAlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <!-- Background and shape -->
        <item name="android:background">@drawable/dialog_card_bg</item>
        <item name="shapeAppearanceOverlay">@style/DialogShape</item>

        <!-- Title and button colors -->
        <item name="colorPrimary">@color/green_500</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="android:textColorPrimary">#212121</item>
        <item name="buttonBarPositiveButtonStyle">@style/DialogPositiveButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/DialogNegativeButton</item>
    </style>

    <style name="DialogShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <style name="DialogPositiveButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/green_500</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="DialogNegativeButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">#888888</item>
    </style>

    <style name="InputFieldStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/rounded_edittext</item>
        <item name="android:padding">12dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:textColorHint">#888</item>
    </style>

</resources>